{
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Read(!**/.env.*.example)",
      "Read(*.key)",
      "Read(*.pem)",
      "Read(credentials*)",
      "Read(secrets*)",
      "Read(*.session)",
      "Read(*.session-journal)",
      "Read(private/**)",
      "Read(logs/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)"
    ]
  }
}
